# LLM Configuration
LLM_API_KEY=
# LLM_MODEL must be set explicitly for the key in use (the old default
# `gemini-1.5-flash` may be retired; use e.g. `gemini-2.0-flash`, a tool-calling model).
LLM_MODEL=gemini-2.0-flash

# External Search Engine (Tavily or Serper)
TAVILY_API_KEY=
SERPER_API_KEY=

# Database Connection
DATABASE_URL=sqlite:///grants.db

# Trusted Domains & Whitelist (comma-separated domains or extensions)
TRUSTED_DOMAINS=gov,edu,org,ac.uk,turkiyeburslari.gov.tr,chevening.org,daad.de,stipendiumhungaricum.hu,fulbrightprogram.org,campusfrance.org

# Alerts & Notifications (optional)
ALERT_WEBHOOK_URL=

# Telegram Integration (Creative / Phase 8 optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=

# ---------------------------------------------------------------------------
# Platform (agent_platform) — orchestrator service on port 8010
# Names only; fill the values you need. LLM_API_KEY / LLM_MODEL /
# TAVILY_API_KEY / SERPER_API_KEY / DATABASE_URL are shared with Role 2 above.
# ---------------------------------------------------------------------------
AGENT_ENGINE=graph
AGENT_OFFLINE=0
GRAPH_MAX_TOOL_ROUNDS=6

LLM_PROVIDER=
LLM_BASE_URL=
LLM_TIMEOUT=25
# Retry transient provider failures (429/500/503/timeout) with backoff.
LLM_MAX_RETRIES=3
# Optional second model tried once after the primary is exhausted.
LLM_FALLBACK_MODEL=

# Absolute paths; empty values default to repository root / package directory.
GRANTS_DB_PATH=
SESSIONS_DB_PATH=

HOST=127.0.0.1
PORT=8010
FORWARDED_ALLOW_IPS=127.0.0.1
RELOAD=0

API_KEY=
RATE_LIMIT_PER_MINUTE=0

# Required in production: reject client-chosen session ids (422).
STRICT_SESSION_IDS=0

# Required in production when the discovery/admin API is exposed.
ADMIN_API_KEY=

# Discovery trigger: top percentage floor and best semantic-fit floor.
EXTERNAL_SEARCH_THRESHOLD=40
EXTERNAL_SEARCH_MIN_FIT=60
EXTERNAL_SEARCH_TIMEOUT_SECONDS=75

SESSION_TTL_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=3600

LOG_LEVEL=INFO
LOG_JSON=0

TOP_GRANTS_LIMIT=10
MAX_MESSAGE_CHARS=4000
HISTORY_TURNS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000,http://127.0.0.1:8001
